### ---------------------------------
### Localhost requests (PORT 3000)
### ---------------------------------
@localUrl = http://localhost:3000
@businessId = 000000000000000000000000

### GET all businesses
GET {{localUrl}}/businesses

### GET business by id
GET {{localUrl}}/businesses/{{businessId}}

### POST create business
POST {{localUrl}}/businesses
Content-Type: application/json

{
  "name": "Sunrise Bakery",
  "ownerName": "Jamie Lopez",
  "businessType": "LLC",
  "state": "ID",
  "einStatus": "Approved",
  "startDate": "2026-08-01",
  "industry": "Food & Beverage",
  "notes": "Planning first storefront launch in Boise."
}

### POST bad business (missing required fields)
POST {{localUrl}}/businesses
Content-Type: application/json

{
  "name": "",
  "state": "Id",
  "einStatus": "in-review"
}

### GET with bad ObjectId (should return 400)
GET {{localUrl}}/businesses/not-a-valid-objectid

### PUT update business
PUT {{localUrl}}/businesses/{{businessId}}
Content-Type: application/json

{
  "name": "Sunrise Bakery Co.",
  "ownerName": "Jamie Lopez",
  "businessType": "LLC",
  "state": "ID",
  "einStatus": "Approved",
  "startDate": "2026-08-01",
  "industry": "Food & Beverage",
  "notes": "Updated notes after investor meeting."
}

### DELETE business
DELETE {{localUrl}}/businesses/{{businessId}}


